test_0
<- concept_test;
<- concept_diagnostic_test;
=> nrel_description:
    [description for test 0]
    (*
        <- lang_ru;;
    *);
=> nrel_themes: { // множество тем
    theme_1;
    theme_2;
    theme_3
};
=> nrel_decomposition: <
    test_0_question_1;
    test_0_question_2;
    test_0_question_3;
    test_0_question_4;
    test_0_question_5
>;
=> nrel_difficulty:
    [4];
<~ rrel_test:
    ...
    (*
        ~> rrel_expected_difficulty:
            [3];; // числовое значение, выражающее сложность темы для конкретного пользователя (2.6)
        ~> rrel_student:
            misha;;
    *);;


test_0_question_1
<- concept_question;
=> nrel_condition:
    [condition 1];
=> nrel_difficulty:
    [2]; // от 0 до 5
<~ rrel_test_question:
    ...
    (*
        ~> rrel_expected_correctness:
            [expected_correctness];; // вероятность правильного ответа учеником
        ~> rrel_student:
            misha;;
    *);
=> nrel_theme:
    theme_1;
=> nrel_possible_answer:
    test_0_question_1_answer_1;
    test_0_question_1_answer_2;
    test_0_question_1_answer_3;
    test_0_question_1_answer_4;
=> nrel_correct_answer:
    test_0_question_1_answer_1
    (*
        => nrel_text: // имеется в виду содержание ответа
            [correct_answer];;
    *);;


test_0_question_1_answer_2
    => nrel_text:
        [no correct answer];;


test_0_question_1_answer_3
    => nrel_text:
        [no correct answer];;


test_0_question_1_answer_4
    => nrel_text:
        [no correct answer];;


