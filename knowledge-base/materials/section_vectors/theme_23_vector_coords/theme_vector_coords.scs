theme_vector_coords
<- concept_theme;
=> nrel_main_idtf:
    [Параграф 23. Координаты вектора]
    (*
        <- lang_ru;;
    *);
=> nrel_idtf:
    [Параграф 23]
    (*
        <- lang_ru;;
    *);
<- concept_vector_section;
=> nrel_key_concepts: {
    concept_vector;
    definition_of_vector;
    concept_collinear_vector;
    definition_of_angle_between_vectors;
    definition_of_zero_vector;
    definition_of_vector_length;
    definition_of_magnitude_of_vector;
    definition_multiplication_of_nonzero_vector_by_scalar_k; // произведение ненулевого вектора на число
    properties_of_scalar_multiplication; // свойства умножения вектора на число
    sum_of_vectors; // сумма векторов
    triangle_rule; // правило треугольника
    parallelogram_rule; // правило параллелограмма
    properties_of_vector_addition; // свойства сложения векторов
    vector_subtraction; // вычитание векторов
    rules_of_vector_subtraction; // правила вычитания векторов 
    theorem_on_decomposing_a_vector_into_two_noncollinear_vectors; // теорема о разложении вектора по двум неколлинеарным векторам
    formula_for_multiplying_a_vector_by_a_scalar; // формула умножения вектора на число
    vector_addition_formula; // формула сложения векторов
    vector_subtraction_formula; // формула вычитания векторов
    theorem_on_collinear_vectors; // теорема о коллинеарных векторах
    formula_for_vector_coordinates_from_points; // формула координат вектора через точки
    theorem_on_vector_length // теорема о длине вектора
};
=> nrel_lessons: {
    theme_23_video_lesson_1;
    theme_23_video_lesson_2;
    theme_23_video_lesson_3
};

=> nrel_tasks: {
    theme_23_task_1
};



=> nrel_tests: {
    theme_23_test_1
};


<= nrel_themes_before_this: {
    theme_types_of_vectors;
   theme_vector_operations
};;
