section_subject_domain_of_student_module
<- sc_node_struct;
=> nrel_main_idtf:
    [Раздел. Предметная область модуля обучения]
    (*
        <- lang_ru;;
    *);
    [Section. Subject domain of student module]
    (*
        <- lang_en;;
    *);
<- atomic_section;;

section_subject_domain_of_student_module = [*
subject_domain_of_student_module
=> nrel_main_idtf:
    [Предметная область модуля обучения]
    (*
        <- lang_ru;;
    *);
    [Subject domain of student module]
    (*
        <- lang_en;;
    *);
    <- subject_domain;;
*];;


discipline_1
<- concept_discipline;
=> nrel_decomposition: <
    theme_1;
    theme_2;
    theme_3
>;;


theme_1
<- concept_theme;
~> rrel_user_knowledge_level:
    normal_knowledge_level;
=> nrel_condition:
    [any string]
    (*
        <- lang_ru;;
    *);
=> nrel_difficulty:
   [0];
<= nrel_themes_before_this: {
    theme_5;
    theme_6
};
=> nrel_tasks: <
    task_1;
    task_2;
    task_3
>;
=> nrel_tests: <
    test_1;
    test_2;
    test_3
>;
=> nrel_decomposition: {
    theme_1_subtheme_1;
    theme_1_subtheme_2;
    theme_1_subtheme_3
};;


task_1
<- concept_task;
=> nrel_condition:
    [any string]
    (*
        <- lang_ru;;
    *);
=> nrel_user_solutions: {
    task_1_solution_1;
    task_1_solution_2
};;
=> nrel_correct_solutions: {
    task_1_correct_solution_1;
    task_1_correct_solution_2;
    task_1_correct_solution_3
};;

task_1_correct_solution_1
<- concept_plan;
= [*
    _action
    <-_ action_solve_task;
    _-> rrel_1:: _some_arg_1;
    _-> rrel_2:: _some_arg_2;
    _=> nrel_result:: _some_result;
    => nrel_decomposition: <
        rrel_1:: _task_1_correct_solution_1_step_1
        (*
            _-> rrel_1:: _some_arg_1;;
            _=> nrel_result:: _some_result_2;;
            _=> nrel_goto:: _task_1_correct_solution_1_step_2;;
        *);;
        _task_1_correct_solution_1_step_2
        (*
            _-> rrel_1:: _some_arg_2;;
            _-> rrel_2:: _some_result_2;;
            _=> nrel_result:: _some_result_3;;
            _=> nrel_goto:: _task_1_correct_solution_1_step_3;;
        *);;
        rrel_last:: _task_1_correct_solution_1_step_3
        (*
            _-> rrel_1:: _some_result_3;;
            _=> nrel_result:: _some_result;;
        *);;        
    >;;
*];;

task_1_solution_1
<- concept_protocol;
= [*
    some_non_atomic_action_solve_task
    <- action_solve_task;
    -> rrel_1: some_arg_1;
    -> rrel_2: some_arg_2;
    => nrel_result: some_result;
    => nrel_decomposition: <
        rrel_1:: task_1_solution_1_step_1
        (*
            -> rrel_1: some_arg_1;;
            => nrel_result: some_result_2;;
            => nrel_goto: task_1_solution_1_step_2;;
        *);;
        task_1_solution_1_step_2
        (*
            -> rrel_1: some_arg_2;;
            -> rrel_2: some_result_2;;
            => nrel_result: some_result_3;;
            => nrel_goto: task_1_solution_1_step_3;;
        *);;
        task_1_solution_1_step_3
        (*
            -> rrel_1: some_arg_2;;
            -> rrel_2: some_arg_1;;
            => nrel_result: some_result_4;;
            => nrel_goto: task_1_solution_1_step_4;;
        *);;
        task_1_solution_1_step_4
        (*
            -> rrel_1: some_arg_2;;
            => nrel_result: some_result_5;;
            => nrel_goto: task_1_solution_1_step_5;;
        *);;
        rrel_last:: task_1_solution_1_step_5
        (*
            -> rrel_1: some_result_3;;
            => nrel_result: some_result;;
        *);;        
    >;;
*];;

task_1_solution_1_step_1
<- concept_step;
-> rrel_1: some_arg_1;;
-> rrel_2: some_arg_1;;
=> nrel_result: some_result;;
=> nrel_goto: task_1_solution_1_step_2;;
=> nrel_used_tools: {
    logic_rule_1;
    theorem_1;
    axiom_1
};;

test_1
<- concept_test;
=> nrel_description:
    [description]
    (*
        <- lang_ru;;
    *);
=> nrel_themes: { // множество тем
    theme_1;
    theme_2
};
=> nrel_decomposition: <
    test_1_question_1;
    test_1_question_2
>;
=> nrel_difficulty:
    [difficulty]
<~ rrel_test:
    ...
    (*
        ~> rrel_expected_difficulty:
            [expected_difficulty];; // числовое значение, выражающее сложность темы для конкретного пользователя (2.6)
        ~> rrel_student:
            misha;;
    *);;

// test_1 => nrel_decomposition: ..questions;;
// @arc1 = (..questions -> test_1_question_1);;
// rrel_1 -> @arc1;;
// @arc2 = (..questions -> test_1_question_2);;
// rrel_last -> @arc2;;
// @arc1 => nrel_basic_sequence: @arc2;;

test_1_question_1
<- concept_question;
=> nrel_condition:
    [condition];
=> nrel_difficulty:
    [difficulty]; // от 0 до 5
<~ rrel_test_question:
    ...
    (*
        ~> rrel_expected_correctness:
            [expected_correctness];; // вероятность правильного ответа учеником
        ~> rrel_student:
            misha;;
    *);;
=> nrel_theme:
    theme_1;
=> nrel_possible_answer:
    test_1_question_1_answer_1;
    test_1_question_1_answer_2;
    test_1_question_1_answer_3;
    test_1_question_1_answer_4;
=> nrel_correct_answer:
    test_1_question_1_answer_1
    (*
        => nrel_text: // имеется в виду содержание ответа
            [correct_answer];;
    *);;

misha
<- concept_student;
=> nrel_tg_id:
    [user id];
=> nrel_name:
    [user_name];
=> nrel_class:
    [9];
=> nrel_preferable_content_types: { // особенности предоставления контента
    concept_video;
    concept_audio
};
=> nrel_personal_characteristics: {
    color_vision_disorder
};
=> nrel_solved_tasks: { // множество решённых задач учащимся
    (nrel_user_solution ~> (task_1 => ..task_1_solution_1));
    (nrel_user_solution ~> (task_3 => ..task_3_solution_1))
};
=> nrel_not_solved_tasks: { // множество нерешённых задач учащимся
    (nrel_user_solution ~> (task_2 => ..task_2_solution_1));
    (nrel_user_solution ~> (task_4 => ..task_4_solution_1))
};
=> nrel_studied_themes: { // множество изученных тем
    ..theme_1;
    ..theme_3
};
=> nrel_achievements: {
    achievement_1;
    achievement_2;
    achievement_3
};;

// 
//
// misha ===========> test_1
//            ||
//            ||
//            || <------- nrel_user_passing_test_history
//            ||
//            \/
//      misha_passing_test_1_history
//            |
//            |
// rrel_1 --> |
//            |
//            \/
//        -----O-----------------------------------         
//        |                  |                    |
//        |                  |                    |
// rrel_test_question rrel_question_answer rrel_passer
//        |                  |                    |
//        |                  |                    |
//       \/                  \/                   \/
// test_1_question_1  test_1_question_1_answer_1 misha
//

@misha_passing_test_1_history = <
    {
        rrel_test_question: test_1_question_1;
        rrel_question_answer: test_1_question_1_answer_1;
        rrel_passer: misha
    };
    {
        rrel_test_question: test_1_question_2;
        rrel_question_answer: test_1_question_2_answer_3;
        rrel_passer: misha
    }
>;;

nrel_user_passing_test_history
-> ((misha => test_1) => @misha_passing_test_1_history);; 


[*
misha
<~ rrel_student:
    ...
    (
        <~ nrel_user_knowledge_level;
        ~> rrel_knowledge_level:
            bad_knowledge_level;
        ~> rrel_theme: {
            theme_2
        };
        ~> rrel_assesser:
            misha
    );
=> nrel_worth_studied_themes: { // так же добавляется и к пользователю
    theme_1;
    theme_2
};
=> nrel_well_studied_themes: { // так же добавляется и к пользователю
    theme_3;
    theme_4;
    theme_5
};;
*]
<= nrel_self_rating:
    misha;;

[*
misha
<~ rrel_student:
    ...
    (
        <~ nrel_user_knowledge_level;
        ~> rrel_knowledge_level:
            normal_knowledge_level;
        ~> rrel_theme: {
            theme_1
        }
        ~> rrel_assesser:
            myself
    );
=> nrel_worth_studied_themes: { // так же добавляется и к пользователю
    theme_1;
    theme_2
};
=> nrel_well_studied_themes: { // так же добавляется и к пользователю
    theme_3;
    theme_4;
    theme_5
};;
*]
<= nrel_system_rating:
    misha;;

[*
misha
=> nrel_underrated_themes:
    concept_underrated_themes;;
=> nrel_overrated_themes:
    concept_overrated_themes;;
*]
<= nrel_self_rating_and_system_rating_comparison:
    misha;;

achievement_1
=> nrel_name:
    [name]
    (*
        <- lang_ru;;
    *);
=> nrel_description:
    [description]
    (*
        <- lang_ru;;
    *);
=> nrel_icon:
    [icon];; // файл типа img

// 1. Какие индивидуальные особенности будут учитываться в системе?
// 2. Как они будут привязываться к учащемуся? (а)
// 3. Как и где мы будем их учитывать? (б)

/*
    Индивидуальные особенности:
    1. Когнитивные особенности (СДВГ, РАС, быстрая утомляемость?):
        a) Привязка к личному кабинету и к тестированию
        б) При прохождении тестирования уменьшать количество вопросов теста
            (например при резком падении стабильности прохождения останавливать тестирование)
    2. Физиологические особенности (нарушения зрения и слуха):
        а) Привязка к личному кабинету и к отображаемому контенту 
        б) Предоставление материала с некоторыми особенностями 
            (более крупный шрифт, субтитры и т.д.)
    3. Мотивационные характеристики
        а) Уровень вовлеченности в процесс обучения (частота активности) (будет использоваться для подстроения рекомендаций так, чтобы учащемуся было интереснее обучаться)
        б) Прдпочтения в типа задания (теория, практика, соревнования, игры)
    4. Цели и интересы
        а) Цель: подготовка к экзамену, олимпиаде, расширенние кругозора (будет использоваться для понимания какие именно зания и навыки необходимо освоить пользователю)
        б) Определять к каким темам учащийся испытывает интерес, чтобы использовать это для таких рекомендаций, которые будут не только давать знания, но и вовлекать
    5. Отношение к критике (в данном случае к ошибкам):
        а) Привязка к личному кабинету и рефлексии
        б) Смягчение (и ужесточение?) обратной связи при допускаемой ошибке и/или рефлексии
*/